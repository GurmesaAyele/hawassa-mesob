generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceProvider {
  id              String    @id @default(cuid())
  /// JSONB: { en: "...", am: "...", sid: "..." }
  name            Json
  code            String    @unique
  icon            String?
  floorRoomNumber String?
  contactPhone    String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  services        Service[]

  @@map("service_providers")
}

model Service {
  id             String          @id @default(cuid())
  providerId     String
  /// JSONB: { en: "...", am: "...", sid: "..." }
  title          Json
  /// JSONB: { en: "...", am: "...", sid: "..." }
  description    Json
  /// JSONB: [{ en: "...", am: "...", sid: "..." }, ...]
  requirements   Json            @default("[]")
  estimatedFee   Float?
  processingDays Int?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  provider       ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  vip_tickets    vip_tickets[]

  @@map("services")
}

model ChatbotFAQ {
  id               String   @id @default(cuid())
  /// JSONB: { en: "...", am: "...", sid: "..." }
  question         Json
  /// JSONB: { en: "...", am: "...", sid: "..." }
  answer           Json
  category         String   @default("general")
  /// JSONB: { en: "...", am: "...", sid: "..." }
  quickButtonLabel Json?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("chatbot_faqs")
}

model Video {
  id          String   @id @default(cuid())
  /// JSONB: { en: "...", am: "...", sid: "..." }
  title       Json
  youtubeUrl  String
  embedUrl    String
  thumbnail   String
  /// JSONB: { en: "...", am: "...", sid: "..." }
  description Json
  duration    String
  views       String
  /// JSONB: { en: "...", am: "...", sid: "..." }
  author      Json
  /// JSONB: { en: "...", am: "...", sid: "..." }
  category    Json
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("videos")
}

model comments {
  id           String   @id
  name         String
  phoneOrEmail String?
  message      String
  category     String   @default("general")
  isReviewed   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model NewsItem {
  id        String   @id @default(cuid())
  /// JSONB: { en: "...", am: "...", sid: "..." }
  title     Json
  /// JSONB: { en: "...", am: "...", sid: "..." }
  content   Json
  image     String?
  /// JSONB: { en: "...", am: "...", sid: "..." }
  author    Json
  /// JSONB: { en: "...", am: "...", sid: "..." }
  category  Json
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("news_items")
}

model Announcement {
  id        String   @id @default(cuid())
  /// JSONB: { en: "...", am: "...", sid: "..." }
  title     Json
  /// JSONB: { en: "...", am: "...", sid: "..." }
  content   Json
  priority  String   @default("medium") // high, medium, low
  type      String   @default("update") // update, alert, event, general
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model MapLocation {
  id        String   @id @default("default-location")
  contact   Json
  map       Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("map_locations")
}

model users {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?
  name         String
  passwordHash String
  role         UserRole @default(CITIZEN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model vip_tickets {
  id           String       @id
  ticketCode   String       @unique
  citizenName  String
  citizenPhone String
  serviceId    String?
  purpose      String?
  slotDate     DateTime
  slotTime     String
  status       TicketStatus @default(PENDING)
  paymentRef   String?
  qrCodeUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  services     Service?     @relation(fields: [serviceId], references: [id])

  @@index([slotDate, slotTime])
  @@index([ticketCode])
}

enum TicketStatus {
  PENDING
  CONFIRMED
  USED
  CANCELLED
}

enum UserRole {
  CITIZEN
  OPERATOR
  SUPER_ADMIN
}
