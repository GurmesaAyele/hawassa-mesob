# ─── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/mesob_hawassa?schema=public"

# ─── Gemini AI ────────────────────────────────────────
GEMINI_API_KEY="your-google-gemini-api-key-here"

# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Security & Rate Limiting ─────────────────────────
# Comma-separated list of allowed frontend origins (e.g. http://localhost:5173,http://10.20.254.64:5173)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Chat rate limiter (max requests per window per IP)
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MS=60000

# General API rate limiter
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# Gemini AI timeout in milliseconds
GEMINI_TIMEOUT_MS=12000

# ─── Cloudinary ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Or:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# ─── Authentication & Admin Sessions ──────────────────
JWT_SECRET="generate-a-strong-32-character-random-secret-key"

