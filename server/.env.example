# ─── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/mesob_hawassa?schema=public"

# ─── Gemini AI ────────────────────────────────────────
GEMINI_API_KEY="your-google-gemini-api-key-here"

# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Security & Rate Limiting ─────────────────────────
# Comma-separated list of allowed frontend origins (e.g. http://localhost:5173,http://10.20.254.64:5173)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Chat rate limiter (max requests per window per IP)
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MS=60000

# ─── Chapa Payment Integration (v2 Test Mode) ─────────
# Secret Key used server-side for hosted checkout initialization and verification
CHAPA_SECRET_KEY="CHASECK_TEST-your-chapa-secret-key-here"
# Public key for frontend elements (if applicable)
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-your-chapa-public-key-here"
# Secret used to verify HMAC-SHA256 signatures on incoming webhooks
CHAPA_WEBHOOK_SECRET="your-chapa-webhook-secret-here"
# Chapa API v1 base URL
CHAPA_BASE_URL="https://api.chapa.co/v1"
# Public HTTPS webhook URL registered with Chapa (use tunneling for local development)
CHAPA_CALLBACK_URL="https://your-domain.ngrok-free.app/api/vip-payments/webhook"
# Return URL where customer is redirected after completing or cancelling hosted checkout
CHAPA_RETURN_URL="http://localhost:5173/vip/payment/callback"
