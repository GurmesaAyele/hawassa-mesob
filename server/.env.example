# ─── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/mesob_hawassa?schema=public"

# ─── Gemini AI ────────────────────────────────────────
GEMINI_API_KEY="your-google-gemini-api-key-here"

# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Security & Rate Limiting ─────────────────────────
# Comma-separated list of allowed frontend origins:
# Production: https://hawassa-mesob.vercel.app
# Local: http://localhost:5173,http://localhost:3000
CORS_ORIGIN="https://hawassa-mesob.vercel.app,http://localhost:5173,http://localhost:3000"
CLIENT_URL="https://hawassa-mesob.vercel.app"

# Chat rate limiter (max requests per window per IP)
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MS=60000

# ─── Chapa Payment Integration (v2 Test Mode) ─────────
# Secret Key used server-side for hosted checkout initialization and verification
CHAPA_SECRET_KEY="CHASECK_TEST-your-chapa-secret-key-here"
# Public key for frontend elements (if applicable)
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-your-chapa-public-key-here"
# Secret used to verify HMAC-SHA256 signatures on incoming webhooks
CHAPA_WEBHOOK_SECRET="your-chapa-webhook-secret-here"
# Chapa API v1 base URL
CHAPA_BASE_URL="https://api.chapa.co/v1"
# Public HTTPS webhook URL registered with Chapa (Render: https://hawassa-mesob-api.onrender.com/api/vip-payments/webhook)
CHAPA_CALLBACK_URL="https://hawassa-mesob-api.onrender.com/api/vip-payments/webhook"
# Return URL where customer is redirected after completing or cancelling hosted checkout
CHAPA_RETURN_URL="https://hawassa-mesob.vercel.app/vip/payment/callback"
# General API rate limiter
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# Gemini AI timeout in milliseconds
GEMINI_TIMEOUT_MS=12000

# ─── Cloudinary ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Or:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# ─── Authentication & Admin Sessions ──────────────────
JWT_SECRET="generate-a-strong-32-character-random-secret-key"

