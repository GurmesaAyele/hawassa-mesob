							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.reservationToken) {",
									"    pm.collectionVariables.set(\"reservationToken\", jsonData.data.reservationToken);",
									"    console.log(\"Saved reservationToken: \" + jsonData.data.reservationToken);",
									"}"
