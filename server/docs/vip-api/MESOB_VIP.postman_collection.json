							],
							"path": [
								"api",
								"vip-tickets",
								"queue",
								"availability"
							]
						},
						"description": "Pre-payment visibility endpoint. Returns acceptingCustomers, placesRemaining, customersWaiting, customersServing, customersCompletedToday, isQueueProgressing, and honest empirical waiting time indicator."
					},
					"response": []
				},
				{
					"name": "4.2 Check Queue Availability with Specific Ticket Reference",
