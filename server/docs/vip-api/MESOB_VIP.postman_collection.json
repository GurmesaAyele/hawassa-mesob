							"raw": "{{baseUrl}}/api/vip-tickets/release-capacity",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"vip-tickets",
								"release-capacity"
							]
						},
						"description": "Explicitly releases a held capacity reservation if checkout is abandoned or cancelled."
					},
