{
	"info": {
		"_postman_id": "b3c9f2e1-4567-4890-a123-mesobvip0001",
		"name": "Hawassa MESOB Center — VIP Priority Walk-In API",
		"description": "Complete Postman API Collection for manual verification and integration of the Hawassa MESOB Center VIP priority walk-in backend.\n\n### Variable Conventions:\n- `{{baseUrl}}`: Server base URL (Default: `http://localhost:5000`)\n- `{{serviceId}}`: First catalog service UUID (auto-populated by Request 1.1)\n- `{{secondServiceId}}`: Second catalog service UUID (auto-populated by Request 1.1)\n- `{{vipReference}}`: Submitted VIP application reference code (auto-populated by Request 2.1)\n- `{{citizenPhone}}`: Citizen phone used in application tracking (`0911223344`)\n- `{{reservationToken}}`: Active capacity reservation token (auto-populated by Request 5.1)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "serviceId",
			"value": "",
			"type": "string"
		},
		{
			"key": "secondServiceId",
			"value": "",
			"type": "string"
		},
		{
			"key": "vipTicketId",
			"value": "",
			"type": "string"
		},
		{
			"key": "vipReference",
			"value": "",
			"type": "string"
		},
		{
			"key": "citizenPhone",
			"value": "0911223344",
			"type": "string"
		},
		{
			"key": "reservationToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Service Catalog",
			"item": [
				{
					"name": "1.1 List All Services (Flat Catalog with VIP Flags)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.success && Array.isArray(jsonData.data) && jsonData.data.length > 0) {",
									"    pm.collectionVariables.set(\"serviceId\", jsonData.data[0].id);",
									"    if (jsonData.data.length > 1) {",
									"        pm.collectionVariables.set(\"secondServiceId\", jsonData.data[1].id);",
									"    }",
									"    console.log(\"Saved serviceId: \" + jsonData.data[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/services?locale=en",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"services"
							],
							"query": [
								{
									"key": "locale",
									"value": "en"
								}
							]
						},
						"description": "Fetches the full catalog of authentic services across Hawassa institutions. Automatically stores the first two service IDs to collection variables `serviceId` and `secondServiceId`."
					},
					"response": []
				},
				{
					"name": "1.2 List VIP-Eligible Services",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/services/vip?locale=en",
							"host": [
