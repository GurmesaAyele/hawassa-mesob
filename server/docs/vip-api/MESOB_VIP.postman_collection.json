								"queue",
								"availability"
							],
							"query": [
								{
									"key": "reference",
									"value": "{{vipReference}}"
								}
							]
						},
						"description": "Availability check with specific ticket reference. Reports ticketLookup, whether capacity is reserved, and explains that an application reference is not an active queue position."
					},
					"response": []
				}
			]
		},
		{
