		{
			"name": "2. VIP Application",
			"item": [
				{
					"name": "2.1 Submit Multi-Service VIP Application",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.reference) {",
									"    pm.collectionVariables.set(\"vipReference\", jsonData.data.reference);",
									"    console.log(\"Saved vipReference: \" + jsonData.data.reference);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"citizenName\": \"Abebe Kebede\",\n  \"citizenPhone\": \"{{citizenPhone}}\",\n  \"purpose\": \"Urgent document authentication and legal dispatch\",\n  \"serviceIds\": [\"{{serviceId}}\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/vip-tickets",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"vip-tickets"
							]
						},
						"description": "Submits a VIP application. Total fee is flat 1,000 ETB. Stores `data.reference` to `{{vipReference}}`."
					},
					"response": []
				},
				{
					"name": "2.2 Get Application by Reference",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/vip-tickets/reference/{{vipReference}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"vip-tickets",
								"reference",
								"{{vipReference}}"
							]
						},
						"description": "Retrieves the submitted application by reference code with masked PII."
					},
					"response": []
				},
				{
					"name": "2.3 List VIP Applications (Filterable)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/vip-tickets?status=PENDING&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"vip-tickets"
							],
							"query": [
								{
									"key": "status",
									"value": "PENDING"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Lists applications with optional status, phone, or service filters."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Customer Tracking",
			"item": [
				{
					"name": "3.1 Track VIP Application (Dual-Factor Reference + Phone)",
