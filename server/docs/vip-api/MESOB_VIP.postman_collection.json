						"url": {
							"raw": "{{baseUrl}}/api/services/vip/{{serviceId}}?locale=en",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"services",
								"vip",
								"{{serviceId}}"
							],
							"query": [
								{
									"key": "locale",
